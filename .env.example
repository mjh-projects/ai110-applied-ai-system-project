# Copy this file to .env and fill in your own key. .env is in .gitignore,
# so it's never committed - never put a real key directly in .env.example.

# Required for the AI dispatcher to call Gemini. Get one at
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the default Gemini model (gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
